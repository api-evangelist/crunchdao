        {
          "info": {
            "name": "List organizers with some filters.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://api.hub.crunchdao.com/v1/organizers",
            "params": [
              {
                "name": "name",
                "value": "",
                "type": "query",
                "description": "Filter on name and display name. Allow for a pattern (%)."
              },
              {
                "name": "member",
                "value": "",
                "type": "query",
                "description": "Filter for organizers where the currnet user is a member of."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort competitions."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Zero-based page index (0..N)"
              },
              {
                "name": "size",
                "value": "",
                "type": "query",
                "description": "The size of the page to be returned"
              }
            ]
          },
          "docs": "List organizers with some filters."
        },
        {
