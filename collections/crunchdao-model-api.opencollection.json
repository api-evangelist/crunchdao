{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tournament activity model API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "model",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List models.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://api.hub.crunchdao.com/v3/competitions/:competitionIdentifier/projects/:userLogin/:projectIdentifier/models",
            "params": [
              {
                "name": "competitionIdentifier",
                "value": "",
                "type": "path"
              },
              {
                "name": "userLogin",
                "value": "",
                "type": "path"
              },
              {
                "name": "projectIdentifier",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "apiKey",
              "value": "{{apiKey}}",
              "placement": "query"
            }
          },
          "docs": "List models."
        },
        {
          "info": {
            "name": "Show a model.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://api.hub.crunchdao.com/v3/competitions/:competitionIdentifier/projects/:userLogin/:projectIdentifier/models/:modelId",
            "params": [
              {
                "name": "competitionIdentifier",
                "value": "",
                "type": "path"
              },
              {
                "name": "userLogin",
                "value": "",
                "type": "path"
              },
              {
                "name": "projectIdentifier",
                "value": "",
                "type": "path"
              },
              {
                "name": "modelId",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "apiKey",
              "value": "{{apiKey}}",
              "placement": "query"
            }
          },
          "docs": "Show a model."
        },
        {
          "info": {
            "name": "List a model's files.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "http://api.hub.crunchdao.com/v3/competitions/:competitionIdentifier/projects/:userLogin/:projectIdentifier/models/:modelId/files",
            "params": [
              {
                "name": "competitionIdentifier",
                "value": "",
                "type": "path"
              },
              {
                "name": "userLogin",
                "value": "",
                "type": "path"
              },
              {
                "name": "projectIdentifier",
                "value": "",
                "type": "path"
              },
              {
                "name": "modelId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List a model's files."
        }
      ]
    }
  ],
  "bundled": true
