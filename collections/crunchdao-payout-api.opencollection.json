            "method": "PATCH",
            "url": "http://api.hub.crunchdao.com/v1/competitions/:competitionIdentifier/payouts/:payoutId",
            "params": [
              {
                "name": "competitionIdentifier",
                "value": "",
                "type": "path"
              },
              {
                "name": "payoutId",
                "value": "",
